        ],
        "summary": "Active Buses",
        "operationId": "active_buses_v1_routes__route__active_buses_get",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "route",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9-]{1,32}$",
              "title": "Route"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseEnvelope_ActiveBusesData_"
                },
                "example": {
                  "source": "univus",
                  "fetched_at": "2026-11-07T04:47:45.932802+00:00",
                  "data": {
                    "TimeStamp": "2026-11-07T12:47:45+08:00",
                    "ActiveBusCount": "1",
                    "activebus": [
                      {
                        "vehplate": "PA1234X",
                        "lat": 1.3039,
                        "lng": 103.7738,
                        "speed": 18,
                        "direction": 92.5,
                        "loadInfo": {
                          "occupancy": 0.35,
                          "crowdLevel": "low",
                          "capacity": 80,
                          "ridership": 28
                        }
                      }
                    ]
                  }
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
